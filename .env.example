# Firebase web app credentials.
#
# Copy to `.env` and fill in from Firebase console > Project settings > Your apps.
# Expo inlines any variable prefixed with EXPO_PUBLIC_ at build time, so these values
# ship in the client bundle — that is expected for Firebase web config, which is not a
# secret. Access control belongs in Firestore security rules.
#
# With these unset the app boots into demo mode against bundled sample content.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
